<Window x:Class="Coucou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Width="290" Height="112"
        ResizeMode="NoResize" Loaded="OnLoaded"
        MouseLeftButtonDown="OnMouseDown" AllowDrop="True"
        DragEnter="OnDragEnter" Drop="OnDrop">
  <Grid>
    <Border Background="#F0121420" CornerRadius="28" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Character" Width="68" Height="68" CornerRadius="34" Background="#FFF6C98E" VerticalAlignment="Center">
          <Grid>
            <Ellipse x:Name="LeftEye" Width="10" Height="14" Fill="#FF2B2830" HorizontalAlignment="Left" Margin="19,18,0,0"/>
            <Ellipse x:Name="RightEye" Width="10" Height="14" Fill="#FF2B2830" HorizontalAlignment="Right" Margin="0,18,19,0"/>
            <Border Width="24" Height="10" CornerRadius="5" Background="#FFEA7A6A" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="CoucouName" Text="Coucou" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="Status" Text="Watching Claude Code…" Foreground="#FFD7D7E0" FontSize="11" Margin="0,3,0,0"/>
          <TextBlock x:Name="Hint" Text="Drop a file • click me" Foreground="#FF9E9DAB" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
