<Window x:Class="Coucou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Width="330" Height="112"
        ResizeMode="NoResize" Loaded="OnLoaded"
        MouseLeftButtonDown="OnMouseDown" AllowDrop="True"
        DragEnter="OnDragEnter" Drop="OnDrop">
  <Border Background="#F0121420" CornerRadius="28" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="82"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Character" Width="68" Height="68" CornerRadius="34"
                Background="#FFF6C98E" VerticalAlignment="Center">
          <Grid>
            <Ellipse x:Name="LeftEye" Width="10" Height="14" Fill="#FF2B2830"
                     HorizontalAlignment="Left" Margin="19,18,0,0"/>
            <Ellipse x:Name="RightEye" Width="10" Height="14" Fill="#FF2B2830"
                     HorizontalAlignment="Right" Margin="0,18,19,0"/>
            <Border Width="24" Height="10" CornerRadius="5" Background="#FFEA7A6A"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,17"/>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="CoucouName" Text="Coucou" Foreground="White"
                     FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="Status" Text="Watching Claude Code…"
                     Foreground="#FFD7D7E0" FontSize="11" Margin="0,3,0,0"/>
          <TextBlock x:Name="Hint" Text="Drop a file • click me"
                     Foreground="#FF9E9DAB" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>

      <Border x:Name="PermissionCard" Grid.Row="1" Visibility="Collapsed"
              Background="#FFF7F3EA" CornerRadius="16" Padding="10" Margin="0,2,0,0">
        <StackPanel>
          <TextBlock x:Name="PermissionTitle" Text="Claude needs permission"
                     FontWeight="SemiBold" Foreground="#FF2B2830" FontSize="12"/>
          <TextBlock x:Name="PermissionCommand" Text="Tool"
                     Foreground="#FF55515B" FontSize="10" TextWrapping="Wrap"
                     MaxHeight="34" Margin="0,4,0,8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Deny" Click="OnDenyPermission" Padding="12,5"
                    Margin="0,0,6,0" Background="#FFE8D9D6" BorderThickness="0"/>
            <Button Content="Allow" Click="OnAllowPermission" Padding="12,5"
                    Background="#FF2B2830" Foreground="White" BorderThickness="0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
