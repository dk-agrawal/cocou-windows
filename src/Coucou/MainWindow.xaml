<Window x:Class="Coucou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Width="520" Height="150"
        ResizeMode="NoResize" Loaded="OnLoaded"
        MouseLeftButtonDown="OnMouseDown" AllowDrop="True"
        DragEnter="OnDragEnter" Drop="OnDrop">
  <Border x:Name="RootBorder" Background="#E9000000" CornerRadius="28" Padding="14,10"
          RenderTransformOrigin="0.5,0">
    <Border.RenderTransform>
      <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="112"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="CharacterCanvas" Width="100" Height="58"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas.RenderTransform>
            <TranslateTransform x:Name="CharacterOffset" X="0" Y="28"/>
          </Canvas.RenderTransform>
          <Border x:Name="Character" Width="58" Height="44" CornerRadius="22"
                  Background="#FFF8F8F9" Canvas.Left="21" Canvas.Top="9"
                  RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
              <TransformGroup>
                <ScaleTransform x:Name="CharacterScale" ScaleX="1" ScaleY="1"/>
                <RotateTransform x:Name="CharacterRotate" Angle="0"/>
              </TransformGroup>
            </Border.RenderTransform>
            <Grid>
              <Ellipse x:Name="LeftEye" Width="7" Height="9" Fill="#FF16171A"
                       HorizontalAlignment="Left" Margin="15,15,0,0"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="LeftEyeScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="RightEye" Width="7" Height="9" Fill="#FF16171A"
                       HorizontalAlignment="Right" Margin="0,15,15,0"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="RightEyeScale" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="9" Height="5" Fill="#FFFFA39B" Canvas.Left="10" Canvas.Top="28" Opacity="0.65"/>
              <Ellipse Width="9" Height="5" Fill="#FFFFA39B" Canvas.Left="39" Canvas.Top="28" Opacity="0.65"/>
              <Border x:Name="Smile" Width="14" Height="6" CornerRadius="3"
                      Background="#FFEC7B72" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
              <Ellipse Width="5" Height="3" Fill="White" HorizontalAlignment="Left" Margin="11,8,0,0" Opacity="0.65"/>
            </Grid>
          </Border>
        </Canvas>

        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="CoucouName" Text="Coucou" Foreground="White"
                     FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="Status" Text="Watching Claude Code…" Foreground="#FFD7D7E0"
                     FontSize="11" Margin="0,22,0,0"/>
        </Grid>
      </Grid>

      <StackPanel Grid.Row="1" x:Name="MainControls" Orientation="Vertical">
        <ComboBox x:Name="SessionPicker" SelectionChanged="OnSessionSelectionChanged"
                  DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                  FontSize="9" Height="23" Margin="0,2,0,0"
                  Background="#FFF7F3EA" BorderThickness="0"
                  Foreground="#FF2B2830"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock x:Name="Hint" Text="Drop a file •" Foreground="#FF9E9DAB" FontSize="10"
                     VerticalAlignment="Center"/>
          <Button Content="Terminal" Click="OnFocusTerminal" Margin="7,0,0,0"
                  Padding="7,3" FontSize="9" Background="#FFEDE7DE"
                  Foreground="#FF2B2830" BorderThickness="0"/>
          <Button Content="Ask Claude" Click="OnAskClick" Margin="4,0,0,0"
                  Padding="8,3" FontSize="9" Background="#FFF7F3EA"
                  Foreground="#FF2B2830" BorderThickness="0"/>
        </StackPanel>
      </StackPanel>

      <Border x:Name="AskCard" Grid.Row="1" Visibility="Collapsed"
              Background="#FFF7F3EA" CornerRadius="16" Padding="11" Margin="0,2,0,0">
        <StackPanel>
          <DockPanel>
            <Button Content="×" DockPanel.Dock="Right" Click="OnCloseCard"
                    Padding="6,1" FontSize="14" Background="Transparent"
                    Foreground="#FF55515B" BorderThickness="0"/>
            <TextBlock Text="Ask Claude" FontWeight="SemiBold" Foreground="#FF2B2830" FontSize="12"
                       VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Margin="0,6,0,0">
            <Button Content="Send" DockPanel.Dock="Right" Click="OnSendAsk"
                    Padding="10,5" Background="#FF2B2830" Foreground="White" BorderThickness="0"/>
            <TextBox x:Name="AskInput" Text="What should I work on next?"
                     Margin="0,0,6,0" Padding="7,5" FontSize="10"
                     BorderThickness="1" BorderBrush="#FFE0D8CE"/>
          </DockPanel>
          <Border Background="#FFF0EBE3" CornerRadius="10" Margin="0,8,0,0"
                  Padding="9" MinHeight="110" MaxHeight="230">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,5">
                <TextBlock Text="Claude Response"
                           Foreground="#FF77727A" FontSize="9" FontWeight="SemiBold"/>
                <TextBlock Text="Not saved"
                           DockPanel.Dock="Right"
                           Foreground="#FFAAA4AA" FontSize="8"/>
              </DockPanel>
              <ScrollViewer x:Name="AskResponseScroll" Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="AskResponse" Text="" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent"
                         Foreground="#FF2B2830" FontSize="10"
                         Padding="0" IsTabStop="False"/>
              </ScrollViewer>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border x:Name="PermissionCard" Grid.Row="1" Visibility="Collapsed"
              Background="#FFF7F3EA" CornerRadius="16" Padding="11" Margin="0,2,0,0">
        <StackPanel>
          <TextBlock x:Name="PermissionTitle" Text="Claude needs permission"
                     FontWeight="SemiBold" Foreground="#FF2B2830" FontSize="12"/>
          <TextBlock x:Name="PermissionCommand" Text="Tool"
                     Foreground="#FF55515B" FontSize="10" TextWrapping="Wrap"
                     MaxHeight="34" Margin="0,4,0,8"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Deny" Click="OnDenyPermission" Padding="12,5"
                    Margin="0,0,6,0" Background="#FFE8D9D6" BorderThickness="0"/>
            <Button Content="Allow" Click="OnAllowPermission" Padding="12,5"
                    Background="#FF2B2830" Foreground="White" BorderThickness="0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
